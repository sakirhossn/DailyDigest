# ==============================================================================
# Daily Current Affairs Agent Configuration
# ==============================================================================

# Target Exam Focus: UPSC | BANK | SSC | RRB | ALL
TARGET_EXAM=ALL

# Delivery Channel: telegram | gmail | both | preview
DISPATCH_CHANNEL=preview

# Daily Schedule Time (24-hour format, e.g. 07:30)
SCHEDULE_TIME=07:30

# ------------------------------------------------------------------------------
# 1. TELEGRAM CONFIGURATION (Required if channel is telegram or both)
# ------------------------------------------------------------------------------
# How to get:
# 1. Message @BotFather on Telegram (https://t.me/BotFather) and type /newbot
# 2. Copy the HTTP API token provided and paste below.
# 3. To find your Chat ID, message @userinfobot (https://t.me/userinfobot) or add your bot
#    to your channel/group and use https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ------------------------------------------------------------------------------
# 2. GMAIL CONFIGURATION (Required if channel is gmail or both)
# ------------------------------------------------------------------------------
# How to get:
# 1. Go to Google Account -> Security (https://myaccount.google.com/security)
# 2. Ensure 2-Step Verification is turned ON.
# 3. Search for "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Generate an App Password for "Mail" and paste the 16-character code below.
# (Note: Do NOT use your normal Gmail account password!)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: Recipient emails (comma-separated if sending to multiple addresses)
GMAIL_TO=your_email@gmail.com

# ------------------------------------------------------------------------------
# 3. AI SUMMARIZATION & QUIZ GENERATION (Optional - Gemini API)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# If left blank, the agent automatically uses its built-in heuristic classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
